package {
    default_team: "trendy_team_fwk_nfc",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libnfc_nqnci_jni_static",
    defaults: ["libnfc_nqnci_jni_defaults"],
    visibility: [
     "//vendor/nxp/opensource/commonsys/packages/apps/Nfc/nci/jni",
    ],
}

cc_library_shared {
    name: "libsn100nfc_nci_jni",
    system_ext_specific: true,
    defaults: ["libnfc_nqnci_jni_defaults"],
}

cc_defaults {
    name: "libnfc_nqnci_jni_defaults",

    cflags:
     ["-DNXP_EXTNS=TRUE",
      "-DNXP_SRD=TRUE",]  + [
      "-DNXP_QTAG=TRUE",]  + [
      "-DFEATURE_SECURE_READER",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Werror",
        "-fexceptions",
    ],
    srcs: ["**/*.cpp"],
    exclude_srcs: [
        "NfcTagTest.cpp",
        "DataQueueTest.cpp",
    ],

    include_dirs: [
        "external/libxml2/include",
        "frameworks/native/include",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/tools/casimir",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/include",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/nfa/include",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/nfc/include",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/gki/ulinux",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/gki/common",
    ] + ["vendor/nxp/opensource/commonsys/external/libnfc-nci/utils/include"],

    shared_libs: [
        "libnativehelper",
        "libcutils",
        "libutils",
        "liblog",
        "libbase",
        // Treble configuration
        "libhidlbase",
        "libutils",
        "libbinder_ndk",
        "libstatssocket",
        "libz",
        "vendor.nxp.hardware.nfc@2.0",
        "vendor.nxp.nxpnfc@2.0",
        "vendor.nxp.nxpnfc_aidl-V1-ndk",
    ],
    product_variables: {
        debuggable: {
            cflags: [
                "-DDCHECK_ALWAYS_ON",
                "-DDTA_ENABLED",
            ],
        },
    },

    static_libs: [
        "android.hardware.nfc@1.0",
        "android.hardware.nfc@1.1",
        "android.hardware.nfc@1.2",
        // Add for AIDL
        "android.hardware.nfc-V2-ndk",
        "libsn100nfcutils",
        "libsn100nfc-nci",
        "libnfc-nqnci_flags",
        "nqlibstatslog_nfc",
        "android_nfc_flags_aconfig_c_lib",
        "server_configurable_flags",
        "libxml2",
    ],

    defaults: [
        "aconfig_lib_cc_static_link.defaults",
    ],

    sanitize: {
        integer_overflow: true,
        misc_undefined: ["bounds"],
        scs: true,
    },
    stl: "libc++_static",
    apex_available: [
        "//apex_available:platform",
        "com.android.nfcservices",
    ],
    required: [
        // Provide a default libnfc-nci.conf in /system/etc for devices that
        // does not ship one in /product
        "libnfc-nci.conf-default",
    ],
}

cc_test {
    name: "libnfc-nqnci-jni-tests",

    srcs: [
        "NfcTagTest.cpp",
        "DataQueueTest.cpp",
    ],

    shared_libs: [
        "libnativehelper",
        "libcutils",
        "libutils",
        "liblog",
        "libbase",
        // Treble configuration
        "libhidlbase",
        "libutils",
        "libbinder_ndk",
        "libstatssocket",
        "libz",
    ],

    static_libs: [
        "libgmock",
        "libgtest",
        "libsn100nfc-nci",
        "libnfc_nqnci_jni_static",
        "android.hardware.nfc@1.0",
        "android.hardware.nfc@1.1",
        "android.hardware.nfc@1.2",
        // Add for AIDL
        "android.hardware.nfc-V2-ndk",
        "libnfcutils",
        "libnfc-nci_flags",
        "nqlibstatslog_nfc",
        "android_nfc_flags_aconfig_c_lib",
        "server_configurable_flags",
        "libxml2",
    ],

    defaults: [
        "aconfig_lib_cc_static_link.defaults",
    ],

    header_libs: [
        "jni_headers",
    ],

    include_dirs: [
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/tools/casimir",
        "vendor/nxp/opensource/commonsys/packages/apps/Nfc/nci/jni",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/include",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/gki/common",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/gki/ulinux",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/nfa/include",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/src/nfc/include",
        "vendor/nxp/opensource/commonsys/external/libnfc-nci/utils/include",
    ],
    test_suites: [
        "general-tests",
        "mts-nfc",
    ],
    test_config_template: "nfc_test_config_template.xml",
    // Support multilib variants (using different suffix per sub-architecture), which is needed on
    // build targets with secondary architectures, as the MTS test suite packaging logic flattens
    // all test artifacts into a single `testcases` directory.
    compile_multilib: "both",
    multilib: {
        lib32: {
            suffix: "32",
        },
        lib64: {
            suffix: "64",
        },
    },
    auto_gen_config: true,
    min_sdk_version: "current",
}
